{
  "name": "os-core-ts",
  "version": "0.0.1",
  "description": "OneSoft Node Core Framework",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "tspc --build tsconfig.build.json",
    "copy-templates": "copyfiles -u 1 templates/**/* dist/templates",
    "copy-static": "copyfiles -u 1 static/**/* dist/static",
    "build-lib": "npm run build && npm run copy-templates && npm run copy-static",
    "build-custom-swagger": "npm run build --prefix ./packages/customSwagger",
    "build-dashboard-service": "npm run build-dashboard-service --prefix ./packages/dashboard",
    "dev": "nodemon ./src/dev.ts",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "os-core-ts": "cli.js"
  },
  "type": "commonjs",
  "author": "One soft",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "aws-sdk": "^2.1692.0",
    "cors": "2.8.5",
    "cron": "2.4.4",
    "dotenv": "16.0.3",
    "express": "4.21.1",
    "express-winston": "4.2.0",
    "glob": "^7.1.7",
    "ioredis": "5.4.1",
    "ip": "2.0.1",
    "md5": "^2.3.0",
    "mongodb": "6.9.0",
    "mongoose": "8.7.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "2.3.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "6.37.4",
    "sqlite3": "^5.1.7",
    "typescript-json-schema": "0.65.1",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.679.0",
    "@types/cors": "2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/ioredis": "5.0.0",
    "@types/ip": "1.1.3",
    "@types/luxon": "^3.3.3",
    "@types/md5": "^2.3.5",
    "@types/multer": "^1.4.12",
    "@types/node": "22.7.6",
    "@types/react": "^19.1.8",
    "copyfiles": "^2.4.1",
    "nodemon": "2.0.20",
    "ts-node": "10.9.2",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.2",
    "typescript-transform-paths": "^3.5.5"
  }
}
