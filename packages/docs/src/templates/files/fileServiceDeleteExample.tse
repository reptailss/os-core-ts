import {{{Controller}}, {{Delete}}, {{FileService}}, {{ParamDec}}} from 'os-core-ts'

@{{Controller}}()
export class FilesController {

	@{{Delete}}('/delete/:filename')
	public async deleteFile(
		@{{ParamDec}}('filename') filePath: string,
	): Promise<boolean> {
		const {result} = await {{FileService}}.delete({
			filePath,
		})
		return result
	}

}