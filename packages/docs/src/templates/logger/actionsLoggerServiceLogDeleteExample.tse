import {{{ActionsLoggerService}}, {{AuthDec}}, {{Controller}}, {{ParamDec}}, {{Delete}}, {{UserInfo}},{{AppError}}} from 'os-core-ts'


type User = {
	name: string
	id: number
}
let users: User[] = []

@{{Controller}}()
export class UsersController {

	constructor(private readonly actionsLoggerService = new {{ActionsLoggerService}}()) {
	}

	@{{Delete}}('/delete/:user_id')
	public async deleteUser(
		@{{AuthDec}} userInfo: {{UserInfo}},
		@{{ParamDec}}('user_id') userId: number,
	): Promise<User> {

		const oldUser = users.find((user) => user.id === userId)
		if (!oldUser) {
			throw new {{AppError}}('User not found', {
				errorKey: 'NOT_FOUND_ERROR',
			})
		}
		users = users.filter((user)=>user.id !== userId)

		await this.actionsLoggerService.logDeleteAction({
			oldValue: oldUser,
			rowId: oldUser.id,
			openUserId: userInfo.open_user_id,
			config: {
				tableName: 'users',
				dbType: 'mysql',
				database: 'socium',
			},
		})

		return oldUser
	}
}