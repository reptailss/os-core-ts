export class ActionsLoggerService {

    public async logCreateAction({
                                     value,
                                     openUserId,
                                     config,
                                     rowId,
                                 }: {
        value: Record<string, unknown>
        openUserId: number
        rowId: string | number
        config: {
            tableName: string
            dbType: string
            database: string
        }
    }): Promise<void>


    public async logUpdateAction({
                                     newValue,
                                     oldValue,
                                     openUserId,
                                     config,
                                     rowId,
                                 }: {
        oldValue: Record<string, unknown>
        newValue: Record<string, unknown>
        openUserId: number
        rowId: string | number
        config: {
            tableName: string
            dbType: string
            database: string
        }
    }): Promise<void>

    public async logDeleteAction({
                                     oldValue,
                                     openUserId,
                                     config,
                                     rowId,
                                 }: {
        oldValue: Record<string, unknown>
        openUserId: number
        rowId: string | number
        config: {
            tableName: string
            dbType: string
            database: string
        }
    }): Promise<void>

}