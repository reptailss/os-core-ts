import {
    {{ModelSqlColumns}},
    {{{ModelSqlColumns}}},
    {{IModelSql}},
    {{SettingsLoadModelSql}},
    {{SqlAssociation}},
    {{SqlIndexes}}
} from 'os-core-ts'

export interface IDbConnectionSql {
    defineModel<
        Row extends object,
        Includes extends Record<string, {{SqlAssociation}}> = {}
    >(
        tableName: string,
        columns: {{{ModelSqlColumns}}<Row>,
        options?: {{SettingsLoadModelSql}},
        includes?: Includes,
        indexes?:{{SqlIndexes}}<Row>
    ): {{IModelSql}}<Row,Includes>

    close(): Promise<void>,

    syncModels(): Promise<void>,

    checkConnection(): Promise<void>,

    query<Row extends object>(
        value: string,
        options?: {
            replacements?: Record<string, string | number | string[] | number[] | undefined>
        },
    ): Promise<Row[]>,

    tableExists(tableName: string): Promise<boolean>,

    getColumnsTable<Row extends object>(tableName: string): Promise<{{ModelSqlColumns}}<Row>>,

    renameColumn(tableName: string, oldName: string, newName: string): Promise<void>,

    addColumn(tableName: string, columnName: string, column: {{ModelSqlColumns}}): Promise<void>,

    changeColumn(tableName: string, columnName: string, column: {{ModelSqlColumns}}): Promise<void>,

    removeColumn(tableName: string, columnName: string): Promise<void>,

    dropTable(tableName: string): Promise<void>,

    createTable<Row extends object>(tableName: string, columns: {{ModelSqlColumns}}<Row>): Promise<void>,

}


