{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "rootDir": ".",
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "declarationDir": "dist/types",
    "preserveConstEnums": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "paths": {
      "@appRequest": [
        "src/appRequest/index"
      ],
      "@access": [
        "src/access/index"
      ],
      "@app": [
        "src/app/index"
      ],
      "@appConfig": [
        "src/appConfig/index"
      ],
      "@appError": [
        "src/appError/index"
      ],
      "@appModule": [
        "src/appModule/index"
      ],
      "@appModule/core": [
        "src/appModule/core"
      ],
      "@appResponse": [
        "src/appResponse/index"
      ],
      "@appRouter": [
        "src/appRouter/index"
      ],
      "@auth": [
        "src/auth/index"
      ],
      "@clientPackages": [
        "src/clientPackages/index"
      ],
      "@controllers": [
        "src/controllers/index"
      ],
      "@cron": [
        "src/cron/index"
      ],
      "@dashboard": [
        "src/dashboard/index"
      ],
      "@dashboard/core": [
        "src/dashboard/core"
      ],
      "@db": [
        "src/db/index"
      ],
      "@decorators": [
        "src/decorators/index"
      ],
      "@decorators/core": [
        "src/decorators/core"
      ],
      "@db/core": [
        "src/db/core"
      ],
      "@domain": [
        "src/domain/index"
      ],
      "@files": [
        "src/files/index"
      ],
      "@health": [
        "src/health/index"
      ],
      "@health/core": [
        "src/health/core"
      ],
      "@helpers": [
        "src/helpers/index"
      ],
      "@logger": [
        "src/logger/index"
      ],
      "@logger/core": [
        "src/logger/core"
      ],
      "@modules": [
        "src/modules/index"
      ],
      "@pagination": [
        "src/pagination/index"
      ],
      "@params": [
        "src/params/index"
      ],
      "@redis": [
        "src/redis/index"
      ],
      "@responseFormat": [
        "src/responseFormat/index"
      ],
      "@routerBuilder": [
        "src/routerBuilder/index"
      ],
      "@services": [
        "src/services/index"
      ],
      "@structureServiceEndpoints": [
        "src/structureServiceEndpoints/index"
      ],
      "@structureServiceEndpoints/core": [
        "src/structureServiceEndpoints/core"
      ],
      "@swagger": [
        "src/swagger/index"
      ],
      "@swagger/core": [
        "src/swagger/core"
      ],
      "@systemRoutes": [
        "src/systemRoutes/index"
      ],
      "@validator": [
        "src/validator/index"
      ],
      "@validator/core": [
        "src/validator/core"
      ],
      "@repository": [
        "src/repository/index"
      ],
      "@repository/core": [
        "src/repository/core"
      ],
      "@di": [
        "src/di/index"
      ],
      "@entity": [
        "src/entity/index"
      ],
      "@tests": [
        "src/tests/index"
      ],
      "@tests/core": [
        "src/tests/core"
      ]
    },
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      },
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      }
    ]
  },
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "example",
    "packages",
    "static",
    "cli.js",
  ]
}
